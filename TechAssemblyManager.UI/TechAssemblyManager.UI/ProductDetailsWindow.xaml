<Window x:Class="TechAssemblyManager.UI.ProductDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TechAssemblyManager.UI"
        mc:Ignorable="d"
         Title="Detalii Produs" Height="300" Width="500" WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <StackPanel>
            <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>
            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <TextBlock Text="Preț:" FontWeight="Bold"/>
            <TextBlock Text="{Binding Price}" Margin="0,0,0,10"/>
            <TextBlock Text="Rating:" FontWeight="Bold"/>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Rating, StringFormat=0.0}" Margin="0,0,5,0"/>
                <StackPanel Orientation="Horizontal" Name="StarPanel" Loaded="StarPanel_Loaded">
                    <Path Width="20" Height="20" Margin="2,0"
                  Data="M10,1 L12,7 H18 L13,11 L15,17 L10,13 L5,17 L7,11 L2,7 H8 Z"
                  Stroke="Black" StrokeThickness="0.5"/>
                    <Path Width="20" Height="20" Margin="2,0"
                  Data="M10,1 L12,7 H18 L13,11 L15,17 L10,13 L5,17 L7,11 L2,7 H8 Z"
                  Stroke="Black" StrokeThickness="0.5"/>
                    <Path Width="20" Height="20" Margin="2,0"
                  Data="M10,1 L12,7 H18 L13,11 L15,17 L10,13 L5,17 L7,11 L2,7 H8 Z"
                  Stroke="Black" StrokeThickness="0.5"/>
                    <Path Width="20" Height="20" Margin="2,0"
                  Data="M10,1 L12,7 H18 L13,11 L15,17 L10,13 L5,17 L7,11 L2,7 H8 Z"
                  Stroke="Black" StrokeThickness="0.5"/>
                    <Path Width="20" Height="20" Margin="2,0"
                  Data="M10,1 L12,7 H18 L13,11 L15,17 L10,13 L5,17 L7,11 L2,7 H8 Z"
                  Stroke="Black" StrokeThickness="0.5"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
